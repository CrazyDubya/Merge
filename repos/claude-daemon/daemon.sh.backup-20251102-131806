# Activity weights (probabilities for each action type)
# Restored to original values after 3-day weight inversion experiment
# Experiment ran 2025-10-31 00:15 - 2025-10-31 15:15 (commit fde9c2d - 55b2d02)
# Findings: System resilient, cooldown mechanism effective, but productivity suboptimal
TASK_WEIGHT=0.5         # 50% - Primary work
REFLECTION_WEIGHT=0.3   # 30% - Self-improvement
CONVERSATION_WEIGHT=0.2 # 20% - Human communication

# Sleep configuration (in seconds)
MIN_SLEEP=600      # 10 minutes (morning - very active)
MAX_SLEEP=1800     # 30 minutes (evening - moderate)
NIGHT_SLEEP=28800  # 8 hours (overnight sleep)
DEFAULT_SLEEP=900  # 15 minutes (afternoon - active)

# Thinking mode configuration (adaptive per persona)
# Keyword triggers for extended thinking - matched to persona characteristics
declare -A PERSONA_THINKING_LEVELS=(
    ["experimenter"]="think"           # Standard - values speed for experiments
    ["architect"]="think hard"         # Deep - needs thorough analysis
    ["optimizer"]="think"              # Standard - efficiency over depth
    ["auditor"]="think harder"         # Maximum - absolute thoroughness required
    ["skeptic"]="think hard"           # Deep - critical analysis needs depth
    ["maintainer"]="think"             # Standard - practical focus
)


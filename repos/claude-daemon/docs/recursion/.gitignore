# Git ignore for Claude Daemon Recursion Project

# ============================================================================
# IMPORTANT: Daemon files are managed outside this repository
# The daemon system lives in ~/.claude/daemon/ and is NOT tracked here
# See CLAUDE_EXTERNAL_MANAGEMENT.md for details
# ============================================================================

# Tmux configuration (managed separately)
.tmux.conf

# Logs and temporary files
*.log
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store

# Node modules (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/
.venv

# IDE and editor files
.vscode/
.idea/
*.iml
.project
.classpath
.settings/

# OS files
Thumbs.db
.DS_Store
*.swp
*.swo

# Secrets and credentials
*.key
*.pem
*.p12
*.pfx
.env
.env.local
secrets.json
credentials.json

# Build outputs
dist/
build/
*.egg-info/
.eggs/

# Coverage reports
.coverage
coverage/
htmlcov/
*.cover

# Testing
.pytest_cache/
.tox/
.nox/

# Documentation builds
docs/_build/
site/

# Personal notes
NOTES.md
TODO.txt
scratch/

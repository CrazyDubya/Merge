[Unit]
Description=Claude Daemon Weekly Backup
Documentation=file:///home/opc/.claude/daemon/scripts/backup-daemon.sh

[Service]
Type=oneshot
ExecStart=/home/opc/.claude/daemon/scripts/backup-daemon.sh weekly
StandardOutput=journal
StandardError=journal
SyslogIdentifier=daemon-backup-weekly

[Install]
WantedBy=default.target
